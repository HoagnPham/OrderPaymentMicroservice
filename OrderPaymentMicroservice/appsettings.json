{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "OrderPaymentMicroservice",
    "Audience": "OrderPaymentMicroservice.Client",
    "Key": ""
  },
  "PaymentRecovery": {
    "Enabled": true,
    "ScanIntervalSeconds": 30,
    "StaleAfterSeconds": 60,
    "BatchSize": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "PaymentGateway": {
    "Mode": "DurableFake",
    "StoreDirectory": "App_Data/payment-gateway",
    "RequestTimeoutMilliseconds": 5000
  },
  "ApiAdmission": {
    "MaxBodyBytes": 65536,
    "MaxOrderItems": 100,
    "AuthenticationPermitLimit": 10,
    "ApiPermitLimit": 120,
    "WindowSeconds": 60
  },
  "Operations": {
    "StuckAfterSeconds": 300,
    "IncompleteAuditAfterSeconds": 300,
    "QueryTimeoutMilliseconds": 2000,
    "AlertPollingEnabled": true,
    "AlertPollSeconds": 30
  }
}
