; Two lines referencing one product. Baseline checked each line independently.
(set-logic QF_LIA)
(declare-const stock Int)
(declare-const q1 Int)
(declare-const q2 Int)
(assert (>= stock 0))
(assert (> q1 0))
(assert (> q2 0))
(push)
(echo "DUPLICATE_LINES_BASELINE_OVERSOLD")
(assert (= stock 10))
(assert (= q1 6))
(assert (= q2 6))
(assert (and (>= stock q1) (>= stock q2)))
(assert (< (- stock q1 q2) 0))
(check-sat)
(get-value (stock q1 q2))
(pop)
(push)
(echo "AGGREGATED_STOCK_CANNOT_BE_NEGATIVE")
(assert (>= stock (+ q1 q2)))
(assert (< (- stock q1 q2) 0))
(check-sat)
(pop)
(push)
(echo "AGGREGATED_EXACT_STOCK_ACCEPTED")
(assert (= stock 10))
(assert (= q1 5))
(assert (= q2 5))
(assert (>= stock (+ q1 q2)))
(assert (= (- stock q1 q2) 0))
(check-sat)
(pop)
