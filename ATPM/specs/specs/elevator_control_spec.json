{
  "name": "elevator_control",
  "description": "He thong dieu khien thang may don gian: mo hinh trang thai (di chuyen/mo cua), 1 ham C ghi log co loi buffer-overflow, 1 ham Python tinh toan tang dich va kiem tra tran so cho bo dem so luot di chuyen.",
  "requirements": [
    {
      "id": "REQ-1",
      "text": "Cua thang may khong duoc mo trong khi dang di chuyen",
      "category": "safety",
      "priority": "HIGH"
    },
    {
      "id": "REQ-2",
      "text": "He thong khong duoc roi vao deadlock (luon quay lai duoc trang thai idle)",
      "category": "liveness",
      "priority": "HIGH"
    },
    {
      "id": "REQ-3",
      "text": "Ham ghi log tang thang may khong duoc gay tran bo dem",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-4",
      "text": "Bo dem tong so luot di chuyen khong duoc tran kieu int 32-bit",
      "category": "safety",
      "priority": "MEDIUM"
    },
    {
      "id": "REQ-5",
      "text": "Ham tinh so tang di chuyen (chia nguyen) khong duoc gay loi chia cho 0",
      "category": "functional",
      "priority": "MEDIUM"
    }
  ],
  "state_machine": {
    "states": [
      "idle_closed",
      "moving_closed",
      "arrived_closed",
      "arrived_open"
    ],
    "initial": [
      "idle_closed"
    ],
    "labeling": {
      "idle_closed": [
        "safe",
        "door_closed"
      ],
      "moving_closed": [
        "moving",
        "door_closed"
      ],
      "arrived_closed": [
        "door_closed"
      ],
      "arrived_open": [
        "door_open"
      ]
    },
    "transitions": [
      [
        "idle_closed",
        "moving_closed"
      ],
      [
        "moving_closed",
        "arrived_closed"
      ],
      [
        "arrived_closed",
        "arrived_open"
      ],
      [
        "arrived_open",
        "idle_closed"
      ]
    ]
  },
  "additional_flows": {},
  "safety_properties": [
    "AG(!violation)"
  ],
  "mutual_exclusion": null,
  "functions": [
    {
      "name": "log_floor_change",
      "language": "c",
      "kind": "buffer_copy",
      "params": [
        "floor_label"
      ],
      "buffer_size": 8,
      "bug": "buffer-overflow"
    },
    {
      "name": "trip_counter_alloc",
      "language": "c",
      "kind": "alloc_release",
      "params": [],
      "buffer_size": 4,
      "bug": null
    },
    {
      "name": "floors_per_trip",
      "language": "python",
      "kind": "divide",
      "params": [
        "total_floors",
        "trips"
      ]
    }
  ],
  "arithmetic_checks": [
    {
      "name": "trip_counter_overflow",
      "int_vars": [
        "x",
        "y"
      ],
      "condition": "x >= 0 and y >= 0 and x + y > 2000000000",
      "overflow_expr": "x + y"
    }
  ],
  "test_cases": [
    {
      "id": "TC-1",
      "requirement_ids": [
        "REQ-1",
        "REQ-2"
      ],
      "title": "Kiem chung mo hinh Kripke khong vi pham AG(moving -> !door_open)",
      "preconditions": "Mo hinh trang thai elevator_control da duoc nap",
      "steps": [
        "Chay verify_specification() tren dac ta",
        "Kiem tra khong co trang thai nao vua co nhan 'moving' vua co nhan 'door_open'"
      ],
      "expected_result": "Khong tim thay vi pham, khong co deadlock",
      "priority": "HIGH"
    },
    {
      "id": "TC-2",
      "requirement_ids": [
        "REQ-3"
      ],
      "title": "Phat hien buffer-overflow trong log_floor_change bang static checker",
      "preconditions": "Ma nguon C da duoc sinh tu dac ta",
      "steps": [
        "Sinh ma nguon bang generate_code_for_spec()",
        "Chay check_c_source() tren ham log_floor_change"
      ],
      "expected_result": "Static checker bao cao it nhat 1 canh bao 'buffer-overflow'",
      "priority": "HIGH"
    }
  ]
}