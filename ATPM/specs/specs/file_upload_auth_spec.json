  "arithmetic_checks": [
    {
      "name": "upload_size_bound",
      "int_vars": [
        "size",
        "chunks"
      ],
      "condition": "size >= 0 and chunks > 0 and size > chunks * 100000000",
      "overflow_expr": "size * chunks"
    }
  ],
