{
  "name": "auth_rate_limit",
  "description": "Hệ thống xác thực đăng nhập có giới hạn số lần thử (rate limiting/lockout): vòng đời phiên từ chưa đăng nhập -> đang xác thực -> đã đăng nhập hoặc bị khóa tạm thời sau quá nhiều lần sai; kèm các hàm xử lý tên đăng nhập/dọn dẹp phiên và bộ đếm số lần thử sai.",
  "requirements": [
    {
      "id": "REQ-1",
      "text": "Hệ thống phải có thể tiến đến trạng thái đã đăng nhập thành công từ trạng thái chưa đăng nhập",
      "category": "functional",
      "priority": "HIGH"
    },
    {
      "id": "REQ-2",
      "text": "Hệ thống không được rơi vào deadlock ở bất kỳ trạng thái vòng đời phiên nào",
      "category": "liveness",
      "priority": "HIGH"
    },
    {
      "id": "REQ-3",
      "text": "Trạng thái 'transient' (đang xác thực) và 'trusted' (đã xác thực) không được đồng thời xảy ra trên cùng 1 trạng thái",
      "category": "safety",
      "priority": "MEDIUM"
    },
    {
      "id": "REQ-4",
      "text": "Hàm phân tích tên đăng nhập từ chuỗi đầu vào không được gây tràn bộ đệm",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-5",
      "text": "Hàm dọn dẹp phiên không được giải phóng cùng một con trỏ nhiều hơn 1 lần",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-6",
      "text": "Bộ đếm số lần thử thất bại + ngưỡng khóa không được tràn kiểu int 32-bit",
      "category": "safety",
      "priority": "MEDIUM"
    },
    {
      "id": "REQ-7",
      "text": "Tỷ lệ đăng nhập thành công/tổng số lần thử không được gây lỗi không kiểm soát với bất kỳ đầu vào nào (vd tổng số lần thử = 0)",
      "category": "functional",
      "priority": "MEDIUM"
    }
  ],
  "state_machine": {
    "states": [
      "unauthenticated",
      "authenticating",
      "authenticated",
      "locked_out"
    ],
    "initial": [
      "unauthenticated"
    ],
    "labeling": {
      "unauthenticated": [
        "public"
      ],
      "authenticating": [
        "transient"
      ],
      "authenticated": [
        "trusted"
      ],
      "locked_out": [
        "blocked"
      ]
    },
    "transitions": [
      [
        "unauthenticated",
        "authenticating"
      ],
      [
        "authenticating",
        "authenticated"
      ],
      [
        "authenticating",
        "unauthenticated"
      ],
      [
        "authenticating",
        "locked_out"
      ],
      [
        "authenticated",
        "unauthenticated"
      ],
      [
        "locked_out",
        "unauthenticated"
      ]
    ]
  },
  "additional_flows": {
    "Chỉ riêng vòng lặp xác thực (bỏ qua khóa)": {
      "states": [
        "unauthenticated",
        "authenticating",
        "authenticated"
      ],
      "initial": [
        "unauthenticated"
      ],
      "labeling": {
        "unauthenticated": [
          "public"
        ],
        "authenticating": [
          "transient"
        ],
        "authenticated": [
          "trusted"
        ]
      },
      "transitions": [
        [
          "unauthenticated",
          "authenticating"
        ],
        [
          "authenticating",
          "authenticated"
        ],
        [
          "authenticating",
          "unauthenticated"
        ],
        [
          "authenticated",
          "unauthenticated"
        ]
      ]
    },
    "Chỉ riêng cơ chế khóa (lockout)": {
      "states": [
        "unauthenticated",
        "authenticating",
        "locked_out"
      ],
      "initial": [
        "unauthenticated"
      ],
      "labeling": {
        "unauthenticated": [
          "public"
        ],
        "authenticating": [
          "transient"
        ],
        "locked_out": [
          "blocked"
        ]
      },
      "transitions": [
        [
          "unauthenticated",
          "authenticating"
        ],
        [
          "authenticating",
          "locked_out"
        ],
        [
          "locked_out",
          "unauthenticated"
        ]
      ]
    }
  },
  "safety_properties": [
    "EF(trusted)"
  ],
  "mutual_exclusion": {
    "atom1": "transient",
    "atom2": "trusted"
  },
  "functions": [
    {
      "name": "parse_username",
      "language": "c",
      "kind": "buffer_copy",
      "params": [
        "raw_username"
      ],
      "buffer_size": 20,
      "bug": "buffer-overflow"
    },
    {
      "name": "cleanup_session",
      "language": "c",
      "kind": "alloc_release",
      "params": [],
      "buffer_size": 8,
      "bug": "double-free"
    },
    {
      "name": "login_success_ratio",
      "language": "python",
      "kind": "divide",
      "params": [
        "success",
        "total"
      ]
    },
    {
      "name": "lockout_bypass_code",
      "language": "python",
      "kind": "magic_value",
      "params": [
        "code_a",
        "code_b"
      ],
      "magic_values": [
        9001,
        4477
      ]
    }
  ],
  "arithmetic_checks": [
    {
      "name": "failed_attempt_counter",
      "int_vars": [
        "failed",
        "threshold"
      ],
      "condition": "failed >= 0 and threshold > 0 and failed > threshold + 2000000000",
      "overflow_expr": "failed + threshold"
    }
  ],
  "test_cases": [
    {
      "id": "TC-1",
      "requirement_ids": [
        "REQ-1"
      ],
      "title": "Dang nhap thanh cong tu dau",
      "preconditions": "Tai khoan hop le, chua dang nhap",
      "steps": [
        "Nhap dung ten dang nhap/mat khau",
        "He thong chuyen sang trang thai xac thuc",
        "Xac thuc thanh cong"
      ],
      "expected_result": "He thong chuyen sang trang thai 'authenticated'",
      "priority": "HIGH"
    },
    {
      "id": "TC-2",
      "requirement_ids": [
        "REQ-2",
        "REQ-3"
      ],
      "title": "Khoa tam thoi sau nhieu lan sai",
      "preconditions": "Da vuot qua nguong so lan thu sai cho phep",
      "steps": [
        "Nhap sai mat khau lien tiep vuot nguong",
        "He thong chuyen sang trang thai 'locked_out'"
      ],
      "expected_result": "Tai khoan bi khoa tam thoi, khong roi vao deadlock, tu dong mo khoa sau thoi gian cho",
      "priority": "HIGH"
    },
    {
      "id": "TC-3",
      "requirement_ids": [
        "REQ-4"
      ],
      "title": "Ten dang nhap qua dai",
      "preconditions": "Ham parse_username duoc goi voi chuoi dai hon buffer_size",
      "steps": [
        "Goi parse_username voi chuoi 100 ky tu"
      ],
      "expected_result": "Khong duoc gay tran bo dem (can dung strncpy thay vi strcpy)",
      "priority": "HIGH"
    }
  ]
}
