{
  "name": "order_payment_microservice_security",
  "description": "Đặc tả kiểm chứng hình thức cho luồng Order-Payment: state machine có xử lý sự cố và phục hồi, safety/liveness, idempotency, serialization payment-cancel, bounded retry, compensation refund, SMT số học, fuzzing xác định, TLC, integration PostgreSQL và mô hình C về an toàn bộ nhớ.",
  "requirements": [
    {
      "id": "REQ-1",
      "text": "Mọi API Cart, Order và Payment phải yêu cầu JWT hợp lệ; chỉ Admin được liệt kê toàn bộ đơn hàng.",
      "category": "safety",
      "priority": "HIGH"
    },
    {
      "id": "REQ-2",
      "text": "Người dùng chỉ được đọc hoặc thay đổi User, Cart, Order và Payment thuộc chính mình; quyền Admin là ngoại lệ được kiểm soát.",
      "category": "safety",
      "priority": "HIGH"
    },
    {
      "id": "REQ-3",
      "text": "Khi tạo đơn, giá sản phẩm phải lấy từ cơ sở dữ liệu phía server, sản phẩm phải tồn tại/đang hoạt động và tồn kho phải đủ.",
      "category": "functional",
      "priority": "HIGH"
    },
    {
      "id": "REQ-4",
      "text": "TotalAmount phải dương, trong giới hạn cho phép và khớp tổng Quantity × UnitPrice với sai số tối đa 0,01; dữ liệu sai phải bị từ chối.",
      "category": "safety",
      "priority": "HIGH"
    },
    {
      "id": "REQ-5",
      "text": "Order chỉ được chuyển theo chuỗi CREATED → VALIDATED → PAYMENT_PENDING → PAID → CONFIRMED → COMPLETED; không bỏ bước, quay ngược hoặc hồi sinh trạng thái terminal.",
      "category": "safety",
      "priority": "HIGH"
    },
    {
      "id": "REQ-6",
      "text": "Order chỉ được chuyển từ PAYMENT_PENDING sang PAID khi có Payment SUCCESS với Amount đúng bằng Order.TotalAmount.",
      "category": "safety",
      "priority": "HIGH"
    },
    {
      "id": "REQ-7",
      "text": "Mỗi yêu cầu thanh toán phải có IdempotencyKey; gửi lại cùng khóa và cùng Amount phải trả về giao dịch cũ, còn tái dùng khóa với Amount khác phải bị từ chối.",
      "category": "functional",
      "priority": "HIGH"
    },
    {
      "id": "REQ-8",
      "text": "Mật khẩu mới phải được băm bằng PasswordHasher có salt/work factor; tài khoản SHA-256 cũ chỉ được xác minh để nâng cấp một lần.",
      "category": "safety",
      "priority": "HIGH"
    },
    {
      "id": "REQ-9",
      "text": "register_user() không được sao chép email dài từ 32 byte trở lên vào buffer stack 32 byte.",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-10",
      "text": "Product name không được vượt biên buffer heap 32 byte; nhánh từ chối vẫn phải giải phóng vùng nhớ đã cấp phát.",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-11",
      "text": "Cart audit log không được đọc CartItem sau khi phần tử đã được free.",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-12",
      "text": "Khi hủy Order trong mô hình C, mảng OrderItem thuộc sở hữu của Order phải được free trước struct cha.",
      "category": "memory",
      "priority": "MEDIUM"
    },
    {
      "id": "REQ-13",
      "text": "Payment cleanup không được free TransactionCode hai lần; con trỏ sở hữu phải được đặt NULL sau lần free đầu.",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-14",
      "text": "Từ mọi trạng thái Order có thể đạt tới, mọi đường thực thi hữu hạn tiến triển phải cuối cùng tới COMPLETED, CANCELLED hoặc FAILED.",
      "category": "liveness",
      "priority": "HIGH"
    },
    {
      "id": "REQ-15",
      "text": "Mỗi trạng thái Order-Payment phải đặc tả sự cố, cách phát hiện, biện pháp xử lý và trạng thái tiếp theo; không được có sự cố không có đường phục hồi hoặc kết thúc.",
      "category": "safety",
      "priority": "HIGH"
    },
    {
      "id": "REQ-16",
      "text": "Retry thanh toán và xác nhận phải có bound; khi hết ngân sách retry phải chuyển FAILED hoặc REFUND_PENDING thay vì lặp vô hạn.",
      "category": "liveness",
      "priority": "HIGH"
    },
    {
      "id": "REQ-17",
      "text": "Nếu gateway đã charge nhưng không thể hoàn tất đơn hoặc commit PAID, hệ thống phải dùng REFUND_PENDING và REFUNDED để bù trừ; không được đổi thẳng sang FAILED.",
      "category": "safety",
      "priority": "HIGH"
    },
    {
      "id": "REQ-18",
      "text": "Payment và cancellation trên cùng Order phải được serialize; không được đồng thời sở hữu critical resource hoặc tạo hai Payment SUCCESS.",
      "category": "safety",
      "priority": "HIGH"
    }
  ],
  "state_machine": {
    "states": [
      "CREATED",
      "VALIDATED",
      "PAYMENT_PENDING",
      "PAYMENT_PROCESSING",
      "PAYMENT_RETRY",
      "PAYMENT_PROCESSING_FINAL",
      "PAID",
      "CONFIRMATION_RETRY",
      "CONFIRMED",
      "REFUND_PENDING",
      "COMPLETED",
      "CANCELLED",
      "PRE_PAYMENT_REJECTED",
      "FAILED",
      "REFUNDED"
    ],
    "initial": [
      "CREATED"
    ],
    "labeling": {
      "CREATED": [
        "created",
        "inventory_unreserved",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "VALIDATED": [
        "validated",
        "inventory_reserved",
        "amount_verified",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "PAYMENT_PENDING": [
        "payment_pending",
        "inventory_reserved",
        "amount_verified",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "PAYMENT_PROCESSING": [
        "payment_processing",
        "inventory_reserved",
        "amount_verified",
        "payment_lock",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "PAYMENT_RETRY": [
        "payment_retry",
        "inventory_reserved",
        "amount_verified",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "PAYMENT_PROCESSING_FINAL": [
        "payment_processing",
        "final_retry",
        "inventory_reserved",
        "amount_verified",
        "payment_lock",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "PAID": [
        "paid",
        "payment_success",
        "amount_verified",
        "inventory_reserved",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "CONFIRMATION_RETRY": [
        "paid",
        "payment_success",
        "confirmation_retry",
        "amount_verified",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "CONFIRMED": [
        "confirmed",
        "paid",
        "payment_success",
        "amount_verified",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "REFUND_PENDING": [
        "paid",
        "payment_success",
        "refund_pending",
        "amount_verified",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "COMPLETED": [
        "completed",
        "paid",
        "payment_success",
        "amount_verified",
        "terminal",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "CANCELLED": [
        "cancelled",
        "inventory_released",
        "terminal",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "PRE_PAYMENT_REJECTED": [
        "failed",
        "pre_payment_failure",
        "inventory_unreserved",
        "terminal",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "FAILED": [
        "failed",
        "inventory_released",
        "terminal",
        "no_invalid_transition",
        "no_resource_conflict"
      ],
      "REFUNDED": [
        "refunded",
        "payment_compensated",
        "inventory_released",
        "terminal",
        "no_invalid_transition",
        "no_resource_conflict"
      ]
    },
    "transitions": [
      [
        "CREATED",
        "VALIDATED"
      ],
      [
        "CREATED",
        "PRE_PAYMENT_REJECTED"
      ],
      [
        "VALIDATED",
