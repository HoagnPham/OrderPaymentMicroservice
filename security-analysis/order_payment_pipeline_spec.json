        "PAID"
      ],
      [
        "PAYMENT_PROCESSING",
        "PAYMENT_RETRY"
      ],
      [
        "PAYMENT_PROCESSING",
        "FAILED"
      ],
      [
        "PAYMENT_PROCESSING",
        "PAYMENT_PROCESSING"
      ],
      [
        "PAYMENT_RETRY",
        "PAYMENT_PROCESSING_FINAL"
      ],
      [
        "PAYMENT_RETRY",
        "PAYMENT_RETRY"
      ],
      [
        "PAYMENT_PROCESSING_FINAL",
        "PAID"
      ],
      [
        "PAYMENT_PROCESSING_FINAL",
        "FAILED"
      ],
      [
        "PAYMENT_PROCESSING_FINAL",
        "PAYMENT_RETRY"
      ],
      [
        "PAID",
        "CONFIRMED"
      ],
      [
        "PAID",
        "PAID"
      ],
      [
        "PAID",
        "CONFIRMATION_RETRY"
      ],
      [
        "PAID",
        "REFUND_PENDING"
      ],
      [
        "CONFIRMATION_RETRY",
        "CONFIRMED"
      ],
      [
        "CONFIRMATION_RETRY",
        "REFUND_PENDING"
      ],
      [
        "CONFIRMED",
        "COMPLETED"
      ],
      [
        "CONFIRMED",
        "REFUND_PENDING"
      ],
      [
        "REFUND_PENDING",
        "REFUNDED"
      ],
      [
        "REFUND_PENDING",
        "REFUND_PENDING"
      ],
      [
        "COMPLETED",
        "COMPLETED"
      ],
      [
        "CANCELLED",
        "CANCELLED"
      ],
      [
        "PRE_PAYMENT_REJECTED",
        "PRE_PAYMENT_REJECTED"
      ],
      [
        "FAILED",
        "FAILED"
      ],
      [
        "REFUNDED",
        "REFUNDED"
      ]
    ]
  },
  "safety_properties": [
    "AG(no_invalid_transition)",
    "AG(no_resource_conflict)",
    "EF(payment_processing)",
    "EF(payment_success)",
    "EF(refund_pending)",
    "EF(refunded)",
    "EF(terminal)"
  ],
  "mutual_exclusion": {
    "atom1": "payment_pending",
    "atom2": "payment_success"
  },
  "functions": [
    {
      "name": "register_user",
      "language": "c",
      "kind": "buffer_copy",
      "params": [
        "input"
      ],
      "buffer_size": 32,
      "bug": "buffer-overflow"
    },
    {
      "name": "import_product_name",
      "language": "c",
      "kind": "buffer_copy",
      "params": [
        "input"
      ],
      "buffer_size": 32,
      "bug": "buffer-overflow"
    },
    {
      "name": "remove_cart_item",
      "language": "c",
      "kind": "alloc_release",
      "params": [
        "removed"
      ],
      "buffer_size": 16,
      "bug": "use-after-free"
    },
    {
      "name": "cancel_order",
      "language": "c",
      "kind": "alloc_release",
      "params": [
        "order",
        "order->items"
      ],
      "buffer_size": 48,
      "bug": "memory-leak"
    },
    {
      "name": "cleanup_payment",
      "language": "c",
      "kind": "alloc_release",
      "params": [
        "transaction_code"
      ],
      "buffer_size": 32,
      "bug": "double-free"
    },
    {
      "name": "safe_divide_retry_budget",
      "language": "python",
      "kind": "divide",
      "params": [
        "remaining_attempts",
        "elapsed_ms"
      ]
    },
    {
      "name": "verify_gateway_callback",
      "language": "python",
      "kind": "magic_value",
      "params": [
        "signature_code",
        "callback_type"
      ],
      "magic_values": [
        4919,
        2026
      ]
    }
  ],
  "arithmetic_checks": [
    {
      "name": "order_item_subtotal_cents",
      "int_vars": [
        "quantity",
        "unit_price_cents"
      ],
      "condition": "1 <= quantity <= 10000 and 1 <= unit_price_cents <= 99999999 and quantity * unit_price_cents > 2147483647",
      "overflow_expr": "quantity * unit_price_cents"
    },
    {
      "name": "order_total_cents",
      "int_vars": [
        "subtotal1",
        "subtotal2"
      ],
      "condition": "subtotal1 >= 0 and subtotal2 >= 0 and subtotal1 + subtotal2 > 2147483647",
      "overflow_expr": "subtotal1 + subtotal2"
    },
    {
      "name": "two_payment_total_cents",
      "int_vars": [
        "payment1_cents",
        "payment2_cents"
      ],
      "condition": "payment1_cents >= 0 and payment2_cents >= 0 and payment1_cents + payment2_cents > 2147483647",
      "overflow_expr": "payment1_cents + payment2_cents"
    },
    {
      "name": "inventory_after_reserve",
      "int_vars": [
        "stock",
        "quantity"
      ],
      "condition": "0 <= stock <= 2147483647 and 1 <= quantity <= 10000 and stock - quantity < 0",
      "overflow_expr": "stock - quantity"
    },
    {
      "name": "retry_counter_increment",
      "int_vars": [
        "retry_count",
        "one"
      ],
      "condition": "0 <= retry_count <= 2147483647 and one == 1 and retry_count + one > 2147483647",
      "overflow_expr": "retry_count + one"
    },
    {
      "name": "refund_total_cents",
      "int_vars": [
        "paid_cents",
        "refunded_cents"
      ],
      "condition": "paid_cents >= 0 and refunded_cents >= 0 and paid_cents + refunded_cents > 2147483647",
      "overflow_expr": "paid_cents + refunded_cents"
    }
  ]
}
